# Backend API manzili (Cloudflare orqali proxy qilingan)
NEXT_PUBLIC_API_URL=https://api.medservice.uz
# Saytning o'z manzili (canonical, sitemap, OG uchun)
NEXT_PUBLIC_SITE_URL=https://medservice.uz

# Fallback Telegram (backend ishlamay qolganda brauzerdan to'g'ridan-to'g'ri yuboriladi).
# DIQQAT: bu token faqat sendMessage huquqiga ega bo'lgan alohida bot bo'lishi kerak.
NEXT_PUBLIC_TG_FALLBACK_TOKEN=
NEXT_PUBLIC_TG_FALLBACK_CHAT_ID=

# Qidiruv tizimlari tasdiqlash kodlari (ixtiyoriy)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
