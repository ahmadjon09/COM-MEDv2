# ---- Server ----
NODE_ENV=production
PORT=4000
# Frontend manzillari (vergul bilan) — CORS uchun
CORS_ORIGINS=https://medservice.uz,https://www.medservice.uz,http://localhost:3000

# ---- Ma'lumotlar bazasi ----
DATABASE_URL=postgresql://user:password@host:5432/medservice?schema=public&sslmode=require

# ---- Redis (kesh + refresh tokenlar) ----
REDIS_URL=redis://default:password@host:6379

# ---- JWT ----
JWT_ACCESS_SECRET=uzun_tasodifiy_satr_almashtiring
JWT_REFRESH_SECRET=boshqa_uzun_tasodifiy_satr
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- imgbb ----
IMGBB_API_KEY=imgbb_api_kalitingiz

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=-1001234567890

# ---- Kesh TTL (soniya) ----
CACHE_TTL=600

# ---- Birinchi admin (seed uchun) ----
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=StrongPass123!
SEED_ADMIN_NAME=Bosh administrator

# ---- AI yordamchi (ixtiyoriy) ----
# Provayderni tanlang: groq | openai | openrouter | custom
# Manzil va model avtomatik qo'yiladi — faqat kalit kerak.
# AI_API_KEY bo'sh bo'lsa, saytdagi chat vidjeti umuman ko'rinmaydi.

AI_PROVIDER=groq
AI_API_KEY=gsk_...        # https://console.groq.com/keys

# Model (ixtiyoriy — bo'sh qoldirsangiz llama-3.3-70b-versatile ishlatiladi).
# Tool-calling'ni qo'llab-quvvatlaydigan Groq modellari:
#   llama-3.3-70b-versatile   — asosiy tanlov, sifatli javob
#   llama-3.1-8b-instant      — juda tez va arzon, sodda savollar uchun
#   openai/gpt-oss-20b        — muqobil variant
# AI_MODEL=llama-3.3-70b-versatile

# Javob uzunligi chegarasi (token)
AI_MAX_TOKENS=500

# Boshqa provayderni ishlatsangiz:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
#
# Yoki to'liq qo'lda:
# AI_PROVIDER=custom
# AI_API_URL=https://api.example.com/v1
# AI_API_KEY=...
# AI_MODEL=...
